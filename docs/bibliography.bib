@article{santolin2023sensitivity,
  title = {Sensitivity to the Sonority Sequencing Principle in Rats ({{Rattus}} Norvegicus)},
  author = {Santolin, Chiara and Crespo-Bojorque, Paola and Sebastian-Galles, Nuria and Toro, Juan Manuel},
  date = {2023-10-09},
  journaltitle = {Scientific Reports},
  shortjournal = {Sci Rep},
  volume = {13},
  number = {1},
  pages = {17036},
  publisher = {Nature Publishing Group},
  issn = {2045-2322},
  doi = {10.1038/s41598-023-44081-y},
  url = {https://www.nature.com/articles/s41598-023-44081-y},
  urldate = {2025-06-16},
  abstract = {Albeit diverse, human languages exhibit universal structures. A salient example is the syllable, an important structure of language acquisition. The structure of syllables is determined by the Sonority Sequencing Principle (SSP), a linguistic constraint according to which phoneme intensity must increase at onset, reaching a peak at nucleus (vowel), and decline at offset. Such structure generates an intensity pattern with an arch shape. In humans, sensitivity to restrictions imposed by the SSP on syllables appears at birth, raising questions about its emergence. We investigated the biological mechanisms at the foundations of the SSP, testing a nonhuman, non-vocal-learner species with the same language materials used with humans. Rats discriminated well-structured syllables (e.g., pras) from ill-structured ones (e.g., lbug) after being familiarized with syllabic structures conforming to the SSP. In contrast, we did not observe evidence that rats familiarized with syllables that violate such constraint discriminated at test. This research provides the first evidence of sensitivity to the SSP in a nonhuman species, which likely stems from evolutionary-ancient cross-species biological predispositions for natural acoustic patterns. Humans’ early sensitivity to the SSP possibly emerges from general auditory processing that favors sounds depicting an arch-shaped envelope, common amongst animal vocalizations. Ancient sensory mechanisms, responsible for processing vocalizations in the wild, would constitute an entry-gate for human language acquisition.},
  langid = {english},
  keywords = {Evolution,Psychology},
  file = {/home/gongcastro/snap/zotero-snap/common/Zotero/storage/RXQVVTUH/Santolin et al. - 2023 - Sensitivity to the sonority sequencing principle in rats (Rattus norvegicus).pdf}
}

@thesis{schutsch2024sensory,
  title = {Sensory Bases of the {{Sonority Sequencing Principle}} in Early Infancy},
  author = {Schutsch, Diana},
  date = {2024-07-01},
  institution = {Universitat Pompeu Fabra},
  location = {Barcelona},
  abstract = {The processing of the speech signal and its regularities is a long-studied topic. Understanding the mechanisms that infants use to make sense of the continuous speech, and detect patterns of syllables early in infancy remains a complex challenge. One approach has been exploring whether these mechanisms are influenced by general sensory processing abilities or if they are specific to language. The present thesis includes two parts: the Sonority Experiment, and the Rule Learning Experiment. The first part aims to investigate infants’ sensitivity to the Sonority Sequencing Principle (SSP) in auditory, non-linguistic inputs using an innovative optical imaging technique, the functional Diffuse Correlation Spectroscopy (fDCS). Stimuli consisted of pure tones structured to mimic syllable patterns following the validation or violation of the SSP. Despite the experiment being ready, due to difficulties with the fDCS device, Sonority Experiment could not be completed. The second part aims at investigating infants’ ability to detect regularities such as AAB and ABB, implemented as made-up words with repetitions of syllables. Also this experiment was conducted using fDCS. A small group of 6-month-old infants participated in the study, implemented using a block design with alternated and non-alternated presentation of the stimuli, as in De La Cruz-Pavía and Gervain, 2023. fDCS was used to measure hemodynamic changes in the brain in response to AAB and ABB patterns. Preliminary results seems to suggest a difference in the hemodynamic response between alternated and non-alternated blocks. Future research should expand the sample size to draw meaningful conclusions.}
}

