@inproceedings{orzechowska2018exponents,
  title = {Exponents of Sonority in {{Slavic}} and {{Germanic}} Languages},
  booktitle = {Speech {{Prosody}} 2018},
  author = {Orzechowska, Paula},
  year = 2018,
  month = jun,
  pages = {999--1003},
  publisher = {ISCA},
  doi = {10.21437/SpeechProsody.2018-202},
  urldate = {2025-05-27},
  abstract = {The study of phonotactics has been largely based on the principle of sonority [19], which orders segments in the syllable according to their articulatory opening. This generalizing principle, however, has been challenged by languages admitting long strings of consonants. Among phonotactically complex systems, Slavic and Germanic families have been mentioned [15]. Therefore, the present contribution aims at decomposing sonority into constituent parameters, which provide more detailed insights into cluster structure. The idea goes in line with previous contribution [16, 17, 18], suggesting that specific parameters of place, manner and voice affect cluster structure to varying degrees, resulting in disproportionate cross-linguistic phonotactic variability. The analysis is based on large sets of word-onset clusters varying in length from CC to CCCC in Polish, Russian, English and German.},
  eventtitle = {Speech {{Prosody}} 2018},
  langid = {english}
}

